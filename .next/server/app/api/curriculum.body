[{"day":1,"domain":"Prompt Engineering","title":"Structured Prompt Design & In-Context Learning","concepts":["Few-shot Prompting","Chain-of-Thought (CoT)","JSON Output Enforcement","System Persona Design"],"sample_questions":["How do you ensure zero-shot JSON output compliance without schema validation errors in production?","Explain the trade-offs between Chain-of-Thought prompting and latency constraints in real-time LLM APIs."]},{"day":4,"domain":"Prompt Engineering","title":"Advanced Reasoning & Tree-of-Thoughts (ToT)","concepts":["Tree-of-Thoughts","Self-Consistency Sampling","Constrained Generation","Prompt Injection Defense"],"sample_questions":["When implementing Tree-of-Thoughts, how do you manage token budgets and compute costs while searching solution trees?","What strategies do you employ to protect agentic system prompts against direct instruction override attacks?"]},{"day":8,"domain":"Vector Databases","title":"Embeddings & Chunking Strategies","concepts":["Semantic Chunking","Parent-Child Documents","Dense vs Sparse Vectors","Embedding Model Selection"],"sample_questions":["How does dynamic semantic chunking differ from fixed token-window chunking in enterprise technical documentation?","Compare dense vector embeddings (e.g. text-embedding-3) with sparse representations (e.g. BM25/SPLADE) for technical code search."]},{"day":12,"domain":"Vector Databases","title":"Vector Indexing & Hybrid Search","concepts":["HNSW Indexing","IVFFlat","Cosine vs Inner Product Distance","Hybrid Reciprocal Rank Fusion (RRF)"],"sample_questions":["Explain HNSW graph construction metrics (m, ef_construction) and how they impact query recall vs write latency.","How does Reciprocal Rank Fusion (RRF) combine sparse BM25 scores with dense cosine similarity vectors?"]},{"day":15,"domain":"RAG Systems","title":"Advanced RAG & Query Transformation","concepts":["HyDE (Hypothetical Document Embeddings)","Sub-query Decomposition","Reranking (Cohere/BGE)","Contextual Compression"],"sample_questions":["Walk me through the pipeline execution of HyDE (Hypothetical Document Embeddings) and when it outperforms standard query embedding.","Why is a cross-encoder reranker necessary after initial vector similarity retrieval in multi-tenant RAG systems?"]},{"day":19,"domain":"Agentic AI","title":"ReAct Framework & Tool Calling","concepts":["ReAct Pattern","Tool Definition & Schemas","Dynamic Function Execution","Loop Termination Safeguards"],"sample_questions":["How do you handle unexpected schema output or runtime exception failures during ReAct agent tool execution loops?","Describe how you prevent infinite loops and runaway token costs in multi-step planning agents."]},{"day":23,"domain":"Model Context Protocol (MCP)","title":"MCP Architecture & Server Development","concepts":["MCP Hosts & Clients","JSON-RPC 2.0 Transport","Tool/Resource/Prompt Capabilities","Server Lifecycle & Auth"],"sample_questions":["What is Model Context Protocol (MCP) and how does standardizing host-server tool definitions improve AI integration scalability?","Explain how MCP handles stateful context resources vs stateless tool invocations across SSE/Stdio transports."]},{"day":27,"domain":"AI Safety & Evaluation","title":"LLM-as-a-Judge & Guardrails","concepts":["Ragas Evaluation Metrics","Faithfulness & Answer Relevance","NeMo Guardrails","Hallucination Detection"],"sample_questions":["How do you construct a continuous automated evaluation pipeline using LLM-as-a-Judge without introduce evaluator bias?","Explain how input and output guardrails intercept non-compliant responses before reaching end users."]},{"day":31,"domain":"Enterprise Deployment","title":"Production Deployment & Monitoring","concepts":["Semantic Caching","vLLM / TensorRT-LLM","Cost & Latency Optimization","Observability (LangSmith/Phoenix)"],"sample_questions":["How does semantic caching using Redis or Qdrant optimize API costs for repetitive enterprise user queries?","Compare vLLM's PagedAttention throughput optimizations with standard HuggingFace pipeline deployments."]}]